<%- include('headerafterlogin'); -%>
    <link rel="stylesheet" href="/css/personal-profile.css">
    <script src="/js/personal-profile.js" defer></script>
    <% const displayName=user.fullname || user.username; %>
        <% const initials=displayName.trim().split(/\s+/).slice(-2).map(part=>
            Array.from(part)[0]).join('').toLocaleUpperCase('vi-VN'); %>
            <main class="gb-profile page">
                <div class="page-heading">
                    <div>
                        <p class="eyebrow">TÀI KHOẢN CỦA BẠN</p>
                        <h1>Hồ sơ cá nhân</h1>
                        <p class="subtitle">Thông tin của bạn. Bảo mật trong tầm tay.</p>
                    </div><span class="account-badge"><span></span> Đã đăng nhập</span>
                </div>
                <div class="profile-layout">
                    <aside class="sidebar">
                        <section class="identity-card card">
                            <div class="avatar" id="profile-avatar" aria-hidden="true">
                                <%= initials %>
                            </div>
                            <h2 id="profile-display-name">
                                <%= displayName %>
                            </h2>
                            <p class="username">@<%= user.username %>
                            </p><span class="role-pill">
                                <%= user.role==='admin' ? 'Quản trị viên' : 'Nhân viên' %>
                            </span>
                            <div class="identity-divider"></div>
                            <dl class="account-details">
                                <div>
                                    <dt>Mã tài khoản</dt>
                                    <dd>#<%= user.id %>
                                    </dd>
                                </div>
                                <div>
                                    <dt>Quyền truy cập</dt>
                                    <dd>
                                        <%= user.role==='admin' ? 'Admin' : 'Staff' %>
                                    </dd>
                                </div>
                            </dl>
                            <p class="identity-note">Tên tài khoản được ghi nhận khi bạn gửi tin nhắn và tạo đơn hàng.
                            </p>
                        </section>
                        <nav class="profile-nav" aria-label="Điều hướng hồ sơ"><a href="#information"><span>01</span>
                                Thông tin cá nhân <span>↗</span></a><a href="#security"><span>02</span> Mật khẩu & bảo
                                mật <span>↗</span></a><a href="#sessions"><span>03</span> Phiên đăng nhập
                                <span>↗</span></a></nav>
                        <% if (user.role==='admin' ) { %><a class="admin-link" href="/admin">Mở trang quản trị
                                <span>↗</span></a>
                            <% } %>
                                <form action="/logout" method="post"><button class="signout-link" type="submit">Đăng
                                        xuất thiết bị này <span>→</span></button></form>
                    </aside>
                    <div class="main-column">
                        <section class="panel card" id="information" aria-labelledby="info-title">
                            <div class="section-heading">
                                <div class="section-number">01</div>
                                <div>
                                    <h2 id="info-title">Thông tin cá nhân</h2>
                                    <p>Cách tên của bạn hiển thị trong hệ thống.</p>
                                </div>
                            </div>
                            <form id="info-form" method="post" action="/profile/info" data-endpoint="/profile/info">
                                <div class="field-grid">
                                    <div class="field"><label for="fullname">Họ và tên</label><input id="fullname"
                                            class="form-control" name="fullname" value="<%= user.fullname || '' %>"
                                            autocomplete="name" maxlength="100" required>
                                        <p class="field-hint">Tên bạn muốn đồng nghiệp nhìn thấy.</p>
                                    </div>
                                    <div class="field"><label for="account-username">Tên tài khoản <span
                                                class="locked">Cố định</span></label><input id="account-username"
                                            class="form-control" value="<%= user.username %>" readonly
                                            aria-describedby="username-hint">
                                        <p class="field-hint" id="username-hint">Giữ cố định để lịch sử thao tác luôn
                                            nhất quán.</p>
                                    </div>
                                </div>
                                <div class="form-footer">
                                    <p class="form-result" role="status" aria-live="polite"></p><button
                                        class="button btn btn-primary" type="submit">Lưu thay đổi ↗</button>
                                </div>
                            </form>
                        </section>
                        <section class="panel card" id="security" aria-labelledby="security-title">
                            <div class="section-heading">
                                <div class="section-number">02</div>
                                <div>
                                    <h2 id="security-title">Mật khẩu & bảo mật</h2>
                                    <p>Một mật khẩu riêng giúp bảo vệ công việc của bạn.</p>
                                </div>
                            </div>
                            <form id="password-form" method="post" action="/api/auth/change-password"
                                data-endpoint="/api/auth/change-password">
                                <div class="field current-password"><label for="oldPassword">Mật khẩu hiện tại</label>
                                    <div class="password-input"><input id="oldPassword" name="oldPassword"
                                            type="password" class="form-control" autocomplete="current-password"
                                            required><button type="button" data-reveal="oldPassword"
                                            aria-controls="oldPassword" aria-pressed="false">Hiện</button></div>
                                </div>
                                <div class="field-grid">
                                    <div class="field"><label for="newPassword">Mật khẩu mới</label>
                                        <div class="password-input"><input id="newPassword" name="newPassword"
                                                type="password" class="form-control" autocomplete="new-password"
                                                minlength="10" required aria-describedby="password-guidance"><button
                                                type="button" data-reveal="newPassword" aria-controls="newPassword"
                                                aria-pressed="false">Hiện</button></div>
                                    </div>
                                    <div class="field"><label for="confirmPassword">Nhập lại mật khẩu mới</label>
                                        <div class="password-input"><input id="confirmPassword" name="confirmPassword"
                                                type="password" class="form-control" autocomplete="new-password"
                                                required><button type="button" data-reveal="confirmPassword"
                                                aria-controls="confirmPassword" aria-pressed="false">Hiện</button></div>
                                    </div>
                                </div>
                                <p id="caps-lock" class="caps-lock" role="status" hidden>Caps Lock đang bật.</p>
                                <div class="password-guidance" id="password-guidance"><span id="rule-length">○ Ít nhất
                                        10 ký tự, tối đa 72 byte</span><span id="rule-match">○ Hai mật khẩu mới trùng
                                        nhau</span></div>
                                <div class="notice"><span aria-hidden="true">↳</span>
                                    <p>Sau khi đổi mật khẩu, bạn sẽ đăng xuất khỏi tất cả thiết bị và cần đăng nhập lại.
                                    </p>
                                </div>
                                <div class="form-footer">
                                    <p class="form-result" role="status" aria-live="polite"></p><button
                                        class="button btn btn-primary" type="submit">Đổi mật khẩu ↗</button>
                                </div>
                            </form>
                        </section>
                        <section class="panel session-panel card" id="sessions" aria-labelledby="sessions-title">
                            <div class="section-heading">
                                <div class="section-number">03</div>
                                <div>
                                    <h2 id="sessions-title">Phiên đăng nhập</h2>
                                    <p>Chủ động bảo vệ tài khoản trên những thiết bị đã dùng.</p>
                                </div>
                            </div>
                            <div class="session-row">
                                <div class="device-icon" aria-hidden="true">▣</div>
                                <div>
                                    <h3>Thiết bị hiện tại</h3>
                                    <p id="current-device">Trình duyệt đang sử dụng</p>
                                </div><span class="session-current">Đang dùng</span>
                            </div>
                            <div class="session-action">
                                <div>
                                    <h3>Đăng xuất mọi thiết bị</h3>
                                    <p>Nên dùng nếu bạn vừa làm việc trên máy dùng chung hoặc nghi ngờ tài khoản bị truy
                                        cập.</p>
                                </div><button class="button btn btn-outline-danger" id="open-revoke" type="button">Đăng
                                    xuất tất cả</button>
                            </div>
                        </section>
                        <footer class="page-footer"><span>GB · Không gian làm việc của bạn</span><span>Bảo vệ tài khoản,
                                bảo vệ công việc.</span></footer>
                    </div>
                </div>
            </main>
            <dialog class="gb-profile" id="revoke-dialog" aria-labelledby="revoke-title">
                <div class="dialog-heading">
                    <h2 id="revoke-title">Đăng xuất mọi thiết bị?</h2><button type="button" class="icon-button"
                        id="close-revoke" aria-label="Đóng">×</button>
                </div>
                <p>Tất cả phiên đăng nhập, bao gồm thiết bị này, sẽ kết thúc. Nhập mật khẩu hiện tại để xác nhận.</p>
                <form id="revoke-form" method="post" action="/profile/revoke-sessions"
                    data-endpoint="/profile/revoke-sessions">
                    <div class="field"><label for="session-password">Mật khẩu hiện tại</label>
                        <div class="password-input"><input id="session-password" name="password" type="password"
                                class="form-control" autocomplete="current-password" required><button type="button"
                                data-reveal="session-password" aria-controls="session-password"
                                aria-pressed="false">Hiện</button></div>
                    </div>
                    <p class="form-result" role="status" aria-live="polite"></p><button class="button btn btn-danger"
                        type="submit">Xác nhận đăng xuất tất cả</button>
                </form>
            </dialog>
            <noscript>
                <p class="noscript">Bật JavaScript để lưu hồ sơ và đổi mật khẩu. Bạn vẫn có thể đăng xuất bằng nút trong
                    hồ sơ.</p>
            </noscript>
            <%- include('footer'); -%>