<!doctype html><html lang="vi"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hồ sơ cá nhân</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<main class="container py-4" style="max-width:640px"><a href="/">Trang chính</a>
<h1 class="mt-3">Hồ sơ cá nhân</h1><p><b><%= user.username %></b> · <%= user.fullname || '' %> · <%= user.role %></p>
<% if (user.role === 'admin') { %><p><a href="/admin">Quản trị hệ thống</a></p><% } %>
<h2 class="h4">Đổi mật khẩu</h2><form id="password-form">
<label class="form-label">Mật khẩu hiện tại</label><input name="oldPassword" type="password" autocomplete="current-password" required class="form-control mb-3">
<label class="form-label">Mật khẩu mới (tối thiểu 10 ký tự)</label><input name="newPassword" type="password" autocomplete="new-password" minlength="10" required class="form-control mb-3">
<label class="form-label">Xác nhận mật khẩu mới</label><input name="confirmPassword" type="password" autocomplete="new-password" required class="form-control mb-3">
<button class="btn btn-primary">Đổi mật khẩu</button><p id="result" role="status" class="mt-3"></p></form></main>
<script>document.getElementById('password-form').addEventListener('submit',async function(e){e.preventDefault();const b=this.querySelector('button');b.disabled=true;try{const r=await fetch('/api/auth/change-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(this)))});const d=await r.json();document.getElementById('result').textContent=d.message;if(d.success){localStorage.removeItem('token');setTimeout(()=>location.assign('/login'),1500);}}catch(_){document.getElementById('result').textContent='Không thể kết nối';}finally{b.disabled=false;}});</script></html>
