          <%- include('shippingAccounts'); -%>
          <%- include('zaloConnection'); -%>

          <div class="card mt-3" id="viettelAccountPanel">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                  <h5 class="mb-1">Tài khoản Viettel Post</h5>
                  <div class="text-muted small">Mỗi tài khoản có kho mặc định và dịch vụ chính dùng khi lên đơn.</div>
                </div>
                <span class="badge text-bg-light"><%= viettelAccounts.length %> tài khoản</span>
              </div>
              <% if (viettelAccountError) { %>
                <div class="alert alert-warning mb-3"><%= viettelAccountError %></div>
              <% } %>
              <div class="row g-3" id="viettelAccountCards">
                <% viettelAccounts.forEach(function(a) { %>
                  <div class="col-12 col-xl-6">
                    <div class="card h-100 border">
                      <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                          <div class="min-w-0">
                            <div class="fw-semibold text-break"><i class="bi bi-truck me-1"></i><%= a.username || ('Viettel #' + a.accountId) %></div>
                            <div class="small text-muted">CUS_ID: <%= a.cusId %></div>
                          </div>
                        </div>
                        <hr>
                        <div class="small mb-2"><strong>Kho:</strong> <%= a.warehouse_name || 'Chưa đặt tên' %></div>
                        <div class="small text-muted mb-2"><%= a.warehouse_address || 'Chưa có địa chỉ kho' %></div>
                        <div class="small mb-1"><strong>Dịch vụ:</strong> <%= a.order_service_name || a.order_service || 'Chưa chọn' %> (<%= a.order_service || '—' %>)</div>
                        <div class="small text-muted mb-3"><%= Number(a.order_service_price || 0).toLocaleString('vi-VN') %> đ · <%= a.order_service_time || 'Chưa có thời gian dự kiến' %></div>
                        <div class="d-flex flex-wrap gap-2">
                          <button class="btn btn-sm btn-primary" type="button" data-vt-action="edit" data-account-id="<%= a.accountId %>" data-username="<%= a.username %>">Cập nhật</button>
                          <button class="btn btn-sm btn-outline-danger" type="button" data-vt-action="delete" data-account-id="<%= a.accountId %>">Xóa</button>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }); %>
                <div class="col-12 col-xl-6">
                  <button type="button" class="card h-100 w-100 border border-2 border-dashed bg-body-tertiary text-secondary" style="min-height:220px" onclick="openViettelModal('add')">
                    <span class="card-body d-flex flex-column justify-content-center align-items-center">
                      <i class="bi bi-plus-circle" style="font-size:2.2rem"></i>
                      <span class="fw-semibold mt-2">Thêm tài khoản Viettel</span>
                    </span>
                  </button>
                </div>
              </div>
            </div>
          </div>
