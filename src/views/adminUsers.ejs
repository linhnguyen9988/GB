<!doctype html><html lang="vi"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tài khoản</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><main class="container py-4"><a href="/admin">Quản trị</a><h1>Tài khoản và phân quyền</h1><p id="result" role="status"></p><table class="table"><thead><tr><th>Tài khoản</th><th>Họ tên</th><th>Quyền</th><th></th></tr></thead><tbody id="users"></tbody></table>
<% if (registerPath) { %><a href="<%= registerPath %>">Tạo tài khoản staff</a><% } %></main>
<script>(async()=>{const result=document.getElementById('result');try{const r=await fetch('/api/admin/users');const d=await r.json();for(const u of d.users){const tr=document.createElement('tr');for(const value of [u.username,u.fullname]){const td=document.createElement('td');td.textContent=value||'';tr.append(td);}const td=document.createElement('td'),s=document.createElement('select');for(const role of ['staff','admin']){const o=new Option(role,role);s.add(o);}s.value=u.role;td.append(s);tr.append(td);const actions=document.createElement('td'),b=document.createElement('button');b.textContent='Lưu';b.className='btn btn-primary';b.onclick=async()=>{b.disabled=true;try{const r=await fetch('/api/admin/users/'+u.id+'/role',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({role:s.value})});const d=await r.json();result.textContent=r.ok?'Đã cập nhật quyền; nhân viên cần đăng nhập lại':d.message;}catch(_){result.textContent='Không thể kết nối';}finally{b.disabled=false;}};actions.append(b);tr.append(actions);document.getElementById('users').append(tr);}}catch(_){result.textContent='Không tải được tài khoản';}})();</script></html>
