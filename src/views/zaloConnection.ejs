<section id="zaloConnection" class="card mt-3" aria-labelledby="zaloConnectionTitle">
  <div class="card-body">
    <h5 id="zaloConnectionTitle" class="mb-1">Kết nối Zalo</h5>
    <p class="small text-body-secondary mb-3">Mở Zalo trên điện thoại để quét mã QR và xác nhận đăng nhập.</p>
    <p data-zalo-account class="mb-2">Đang tải kết nối…</p>
    <div class="d-flex flex-wrap gap-2 mb-3">
      <button type="button" data-zalo-start class="btn btn-primary" disabled>Tạo mã QR</button>
      <button type="button" data-zalo-cancel class="btn btn-outline-secondary" hidden>Hủy mã QR</button>
      <button type="button" data-zalo-verify class="btn btn-outline-primary" hidden>Kiểm tra kết nối</button>
      <button type="button" data-zalo-disconnect class="btn btn-outline-danger" hidden>Gỡ kết nối</button>
    </div>
    <img data-zalo-qr width="240" height="240" class="img-fluid rounded border mb-2"
         alt="Mã QR để đăng nhập bằng ứng dụng Zalo" hidden>
    <p data-zalo-status class="small text-body-secondary mb-0" role="status" aria-live="polite"></p>
    <p data-zalo-message class="small mb-0" role="status" aria-live="polite"></p>
    <div data-zalo-groups class="mt-3 pt-3 border-top" hidden>
      <h6>Nhóm nhận cảnh báo đơn</h6>
      <p data-zalo-shipment-group class="small text-body-secondary mb-2"></p>
      <button type="button" data-zalo-fetch-groups class="btn btn-outline-primary mb-2">Tải tất cả nhóm Zalo</button>
      <label for="zaloGroupSelect" class="form-label">Chọn nhóm</label>
      <select id="zaloGroupSelect" data-zalo-group-select class="form-select mb-2" disabled>
        <option value="">Tải danh sách nhóm để chọn</option>
      </select>
      <label for="zaloGroupId" class="form-label">ID nhóm</label>
      <div class="input-group mb-2">
        <input id="zaloGroupId" data-zalo-group-id class="form-control" readonly>
        <button type="button" data-zalo-copy-group class="btn btn-outline-secondary" disabled>Sao chép ID</button>
      </div>
      <button type="button" data-zalo-save-group class="btn btn-primary" disabled>Dùng nhóm này để báo đơn</button>
      <p data-zalo-group-status class="small mt-2 mb-0" role="status" aria-live="polite"></p>
    </div>
    <form data-zalo-send-form class="mt-3 pt-3 border-top" hidden>
      <h6>Gửi tin nhắn thử</h6>
      <label for="zaloTestPhone" class="form-label">Số điện thoại người nhận</label>
      <div class="input-group">
        <input type="tel" id="zaloTestPhone" data-zalo-phone class="form-control" placeholder="09… hoặc +84…"
               autocomplete="off" maxlength="32" required>
        <button type="button" data-zalo-check-phone class="btn btn-outline-primary">Kiểm tra số</button>
      </div>
      <p data-zalo-recipient class="small mt-2 mb-3" aria-live="polite"></p>
      <label for="zaloTestMessage" class="form-label">Nội dung</label>
      <textarea id="zaloTestMessage" data-zalo-text class="form-control" rows="3" maxlength="2000" required></textarea>
      <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
        <button type="button" data-zalo-send class="btn btn-primary" disabled>Gửi thử</button>
        <span data-zalo-send-status class="small" role="status" aria-live="polite"></span>
      </div>
    </form>
  </div>
</section>
<script src="/js/admin-zalo-connection.js?v=20261110-shipment-groups" defer></script>
